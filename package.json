{
  "name": "taqtile-bot",
  "version": "1.0.0",
  "description": "Este projeto contém um CRUD feito com graphql e typescript.",
  "main": "index.js",
  "scripts": {
    "db:gen": "prisma generate --schema src/data/db/schema.prisma",
    "migration:gen": "prisma migrate dev --schema src/data/db/schema.prisma",
    "migration:deploy": "prisma migrate deploy --schema src/data/db/schema.prisma",
    "seeds": "npm run migration:deploy && prisma db seed",
    "predev": "npm run migration:deploy",
    "dev": "tsnd --transpile-only --ignore-watch node_modules -r tsconfig-paths/register src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "dotenv -e .env.example -- npm run migration:deploy",
    "test": "dotenv -e .env.example -- mocha"
  },
  "keywords": [],
  "author": "walefy",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.20.0",
    "apollo-server-express": "3.11.1",
    "class-validator": "0.14.1",
    "cors": "2.8.5",
    "express": "4.18.2",
    "graphql": "16.9.0",
    "graphql-scalars": "1.23.0",
    "graphql-upload-ts": "2.1.2",
    "handlebars": "4.7.8",
    "jsonwebtoken": "9.0.2",
    "papaparse": "5.4.1",
    "reflect-metadata": "0.2.2",
    "resend": "4.0.1-alpha.0",
    "type-graphql": "2.0.0-rc.2",
    "typedi": "0.10.0"
  },
  "devDependencies": {
    "@eslint/js": "9.11.1",
    "@types/chai": "5.0.0",
    "@types/express": "4.17.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/mocha": "10.0.8",
    "@types/papaparse": "5.3.15",
    "@types/sinon": "17.0.3",
    "axios": "1.7.7",
    "chai": "4.4.1",
    "dotenv-cli": "7.4.2",
    "eslint": "9.11.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-unicorn": "55.0.0",
    "form-data": "4.0.1",
    "globals": "15.9.0",
    "mocha": "10.7.3",
    "prettier": "3.3.3",
    "prisma": "5.20.0",
    "sinon": "19.0.2",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.4",
    "typescript-eslint": "8.7.0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only -r tsconfig-paths/register ./src/data/db/seed.ts"
  }
}
