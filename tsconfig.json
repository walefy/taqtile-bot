{
  "compilerOptions": {
    "target": "es2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "baseUrl": "./src",
    "paths": {
      "@domain": [
        "./domain"
      ],
      "@domain/*": [
        "./domain/*"
      ],
      "@graphql": [
        "./api/graphql"
      ],
      "@graphql/*": [
        "./api/graphql/*"
      ],
      "@core": [
        "./core"
      ],
      "@core/*": [
        "./core/*"
      ]
    }
  },
  "include": ["src/**/*"]
}
